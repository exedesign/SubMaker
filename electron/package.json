{
  "name": "submaker",
  "version": "1.0.0",
  "description": "Local Subtitle Generator - Create professional subtitled videos",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:preview": "vite build && electron ."
  },
  "author": "SubMaker",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "butterchurn": "^2.6.7",
    "butterchurn-presets": "2.4.7",
    "react": "^18.2.0",
    "react-color": "^2.19.3",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.0",
    "react-icons": "^5.0.0",
    "socket.io-client": "^4.7.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.submaker.app",
    "productName": "SubMaker",
    "copyright": "Copyright © 2026 SubMaker",
    "directories": {
      "output": "release/build"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico",
      "legalTrademarks": "Copyright © 2026 SubMaker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeader": "public/installer-header.bmp",
      "installerSidebar": "public/installer-sidebar.bmp",
      "license": "public/license.txt",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SubMaker",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": ["en_US", "tr_TR"]
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    },
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!__pycache__/**",
          "!*.pyc",
          "!venv/**",
          "!venv/**/*"
        ]
      },
      {
        "from": "../resources/fonts",
        "to": "resources/fonts",
        "filter": ["**/*"]
      },
      {
        "from": "../resources/presets",
        "to": "resources/presets",
        "filter": ["**/*"]
      },
      {
        "from": "../resources/models",
        "to": "resources/models",
        "filter": ["**/*"]
      }
    ]
  }
}
